      "callHistory": [
        {
          "callId": null,
          "timestamp": "2025-09-28T21:55:54.665Z",
          "transcript": {
            "conversation": [
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "Hello Jeff Banderish! It’s great to connect with you today. Could you please confirm your date of birth for me? Once we’ve got that, we’ll dive right into your wellness check and talk about how you’re feeling, your medications, and your overall wellbeing."
                  }
                ],
                "timestamp": "2025-09-28T21:54:38.574Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "Thank you, Jeff. I’ve got your date of birth as November 29, 1976. Let’s go ahead and check in on how you’re feeling today. Are you experiencing any symptoms or discomfort right now?"
                  }
                ],
                "timestamp": "2025-09-28T21:54:47.402Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "I’m glad to hear that. Now let’s talk about your medications. Are you taking all your medications as prescribed?"
                  }
                ],
                "timestamp": "2025-09-28T21:55:04.624Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "Thank you for letting me know. It's important to discuss that carefully. Cocaine use can have serious health effects, especially if you're on other medications."
                  }
                ],
                "timestamp": "2025-09-28T21:55:15.041Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "I understand, Jeff. Let's take this step by step. Can you tell me more about how often you're using cocaine and any effects you’ve noticed on your body or mood?"
                  }
                ],
                "timestamp": "2025-09-28T21:55:19.055Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "Thank you for sharing that."
                  }
                ],
                "timestamp": "2025-09-28T21:55:32.010Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "I hear you, Jeff. Even if it feels good at times, using cocaine can have serious long-term effects on your heart, blood pressure, and mental health. Are you noticing any physical symptoms, like palpitations, trouble breathing, or mood swings?"
                  }
                ],
                "timestamp": "2025-09-28T21:55:36.725Z"
              },
              {
                "role": "assistant",
                "content": [
                  {
                    "type": "output_audio",
                    "transcript": "I'm really glad you're sharing this. Your health is our top priority. Could you describe those symptoms a bit more? For example, how often are you feeling palpitations or mood swings, and how severe are they?"
                  }
                ],
                "timestamp": "2025-09-28T21:55:52.826Z"
              }
            ],
