# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxx

# Server Configuration
PORT=5051

# ngrok URL - Update this after starting ngrok (local development)
# For production, this will be your Vercel URL
BASE_URL=https://your-ngrok-subdomain.ngrok.app

# Optional: Enable call recording (requires patient consent)
ENABLE_RECORDING=false

# ========================================
# Database Configuration
# ========================================
# Set to 'true' to use Firestore (production), 'false' for SQLite (local development)
USE_FIRESTORE=false

# Firebase Configuration (required when USE_FIRESTORE=true)
# For local development: Create firebase-service-account.json in call-management/database/
# For Vercel deployment: Set FIREBASE_SERVICE_ACCOUNT_JSON environment variable with full JSON

# Option 1: Path to service account file (local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./call-management/database/firebase-service-account.json

# Option 2: JSON string (Vercel/production - set in Vercel dashboard)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Firebase Database URL (optional, if using Realtime Database)
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
